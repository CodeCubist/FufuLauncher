<Page x:Class="FufuLauncher.Views.SettingsPage"
      x:Name="SettingsPageRoot"
      NavigationCacheMode="Required"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="using:FufuLauncher.Helpers"
      xmlns:models="using:FufuLauncher.Models"
      xmlns:viewModels="using:FufuLauncher.ViewModels"
      xmlns:converters="using:FufuLauncher.Converters"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#E5FFFFFF" TintColor="#FFFFFF"
                                  TintOpacity="0.6" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#CC000000" TintColor="#000000"
                                  TintOpacity="0.15" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="White" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#B3FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <helpers:EnumToIntConverter x:Key="EnumToIntConverter" />
            <helpers:LanguageEnumToBooleanConverter x:Key="LanguageEnumToBooleanConverter" />
            <helpers:WindowModeEnumToBooleanConverter x:Key="WindowModeEnumToBooleanConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolInverter x:Key="BoolInverter" />

            <Storyboard x:Name="EntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24" />
            </Style>
            
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SafeSecondaryTextBrush}" />
                <Setter Property="Margin" Value="4,0,0,8" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            </Style>

            <Style x:Key="SectionBlockStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
            
            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="-10,0,-10,0" />
                <Setter Property="Padding" Value="10,10,10,10" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Tag" Value="SettingsRow" />
            </Style>

            <Style x:Key="RowIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>

            <Style x:Key="RowTextStyle" TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="Tag" Value="RowTitle" />
            </Style>

            <Style x:Key="RowCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            </Style>
            
            <Style x:Key="CardIntroStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            </Style>
            
            <Style x:Key="RowDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource SafeBorderBrush}" />
                <Setter Property="Margin" Value="-24,6,-24,6" />
            </Style>
            
            <Style x:Key="RowSubPanelStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="36,0,0,10" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="RowSubRowStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowTextBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="180" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="160" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            
            <Style x:Key="PresetButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SafeCardBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SafeTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="SubPanelButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            
            <Style x:Key="RowInfoButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowInfoBarStyle" TargetType="InfoBar">
                <Setter Property="IsOpen" Value="True" />
                <Setter Property="IsClosable" Value="False" />
                <Setter Property="Margin" Value="0,4,0,6" />
            </Style>

            <Style x:Key="RowRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="PathTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="520" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootLayoutGrid" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="40" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootLayoutScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <NavigationView x:Name="SettingsNavigationView"
                        Grid.Column="0"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        SelectionChanged="SettingsNavigationView_SelectionChanged"
                        Margin="0,0,0,0"
                        Width="248">
            <NavigationView.MenuItems>

                <NavigationViewItemHeader Content="{helpers:Loc Key=SettingsGroupPersonalization}" />

                <NavigationViewItem Content="{helpers:Loc Key=SectionAppearance}" Tag="AppearanceItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=HomeCardDisplayTitle}" Tag="HomeCardsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=WidgetItemsTitle}" Tag="WidgetsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=NotesItemsTitle}" Tag="NotesItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionHomeText}" Tag="HomeTextItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionBackground}" Tag="BackgroundItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionWindowEffects}" Tag="WindowEffectsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B3;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{helpers:Loc Key=SettingsGroupGame}" />

                <NavigationViewItem Content="{helpers:Loc Key=SectionLaunchConfig}" Tag="LaunchConfigItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionScreenshotSettings}" Tag="ScreenshotSettingsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionCheckinSettings}" Tag="CheckinSettingsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{helpers:Loc Key=SettingsGroupApp}" />

                <NavigationViewItem Content="{helpers:Loc Key=SectionLanguage}" Tag="LanguageItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF2B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionWindowBehavior}" Tag="WindowBehaviorItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionStartupSound}" Tag="StartupSoundItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionAdvancedOptions}" Tag="AdvancedOptionsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionUpdate}" Tag="UpdateItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{helpers:Loc Key=SettingsGroupAbout}" />

                <NavigationViewItem Content="{helpers:Loc Key=SectionAbout}" Tag="AboutItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{helpers:Loc Key=SectionSecurityAuth}" Tag="SecurityAuthItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
        
        <Grid Grid.Column="1">

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Padding="32,20,32,40"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          ViewChanged="SettingsScrollViewer_ViewChanged">
                <StackPanel MaxWidth="980" HorizontalAlignment="Center">
                    
                    <Border Style="{StaticResource SettingsCardStyle}"
                            Padding="24,14"
                            Margin="0,0,0,24"
                            Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <Rectangle Width="4"
                                       Height="24"
                                       RadiusX="2"
                                       RadiusY="2"
                                       VerticalAlignment="Center"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                            <TextBlock Grid.Column="1"
                                       Margin="12,0,24,0"
                                       Text="{helpers:Loc Key=NavSettings}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       FontFamily="{StaticResource AppGlobalFont}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <AutoSuggestBox x:Name="SettingsSearchBox"
                                            Grid.Column="2"
                                            Width="320"
                                            Height="36"
                                            CornerRadius="8"
                                            QueryIcon="Find"
                                            TextMemberPath="Title"
                                            VerticalAlignment="Center"
                                            PlaceholderText="{helpers:Loc Key=SettingsSearchPlaceholder}"
                                            TextChanged="SettingsSearchBox_TextChanged"
                                            SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                                            QuerySubmitted="SettingsSearchBox_QuerySubmitted">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="2,6" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Section}" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                        </Grid>
                    </Border>
                    
                    <StackPanel x:Name="AppearanceItem" Style="{StaticResource SectionBlockStyle}">
                        <TextBlock Text="{helpers:Loc Key=SectionAppearance}" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <StackPanel>

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE706;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=ThemeTitle}" />
                                        <TextBlock Style="{StaticResource RowCaptionStyle}" Text="{helpers:Loc Key=ThemeCaption}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Style="{StaticResource RowSubPanelStyle}" Orientation="Horizontal" Spacing="20">
                                    <RadioButton Style="{StaticResource RowRadioButtonStyle}"
                                                 Content="{helpers:Loc Key=ThemeLight}"
                                                 GroupName="AppTheme"
                                                 Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                                 IsChecked="{x:Bind ViewModel.ElementTheme, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}">
                                        <RadioButton.CommandParameter>
                                            <ElementTheme>Light</ElementTheme>
                                        </RadioButton.CommandParameter>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource RowRadioButtonStyle}"
                                                 Content="{helpers:Loc Key=ThemeDark}"
                                                 GroupName="AppTheme"
                                                 Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                                 IsChecked="{x:Bind ViewModel.ElementTheme, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}">
                                        <RadioButton.CommandParameter>
                                            <ElementTheme>Dark</ElementTheme>
                                        </RadioButton.CommandParameter>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource RowRadioButtonStyle}"
                                                 Content="{helpers:Loc Key=ThemeSystem}"
                                                 GroupName="AppTheme"
                                                 Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                                 IsChecked="{x:Bind ViewModel.ElementTheme, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default}">
                                        <RadioButton.CommandParameter>
                                            <ElementTheme>Default</ElementTheme>
                                        </RadioButton.CommandParameter>
                                    </RadioButton>
                                </StackPanel>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE790;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=CustomThemeColorTitle}" />
                                        <TextBlock Style="{StaticResource RowCaptionStyle}" Text="{helpers:Loc Key=CustomThemeColorCaption}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource RowTextBoxStyle}"
                                             Width="160"
                                             PlaceholderText="#FFB6C1"
                                             Text="{x:Bind ViewModel.AppThemeColor, Mode=TwoWay}" />
                                </Grid>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE768;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=LaunchButtonBgColorTitle}" />
                                        <TextBlock Style="{StaticResource RowCaptionStyle}" Text="{helpers:Loc Key=ColorHex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource RowSubRowStyle}" Margin="16,0,0,0" Spacing="8">
                                        <TextBox Width="140"
                                                 VerticalAlignment="Center"
                                                 PlaceholderText="#0078D7"
                                                 Text="{x:Bind ViewModel.LaunchButtonOverlayColor, Mode=TwoWay}" />
                                        <Button Style="{StaticResource PresetButtonStyle}"
                                                Content="{helpers:Loc Key=RestoreDefault}"
                                                Command="{x:Bind ViewModel.ResetLaunchButtonOverlayColorCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE8F2;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="字体大小" />
                                        <TextBlock Style="{StaticResource RowCaptionStyle}" Text="调整界面所有文字大小（0.8× ～ 1.6×，默认 1.0×）" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource RowSubRowStyle}" Margin="16,0,0,0">
                                        <Slider x:Name="FontScaleSlider"
                                                Width="220" Minimum="0.8" Maximum="1.6" StepFrequency="0.05"
                                                Value="{x:Bind ViewModel.FontScale, Mode=TwoWay}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   MinWidth="44"
                                                   Text="{Binding Value, ElementName=FontScaleSlider, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:F2}×'}" />
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel x:Name="HomeCardsItem" Style="{StaticResource SectionBlockStyle}">
                        <TextBlock Text="{helpers:Loc Key=HomeCardDisplayTitle}" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIntroStyle}" Text="{helpers:Loc Key=HomeCardDisplayCaption}" />
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE7C3;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=HideGameNewsCard}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Style="{StaticResource RowToggleStyle}"
                                                  IsOn="{x:Bind ViewModel.IsHideGameNewsCardEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE73E;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=HideCheckinCard}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Style="{StaticResource RowToggleStyle}"
                                                  IsOn="{x:Bind ViewModel.IsHideCheckinCardEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource RowIconStyle}" Glyph="&#xE768;" />
                                    <StackPanel Grid.Column="1" Style="{StaticResource RowTextStyle}">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="{helpers:Loc Key=ShowPresetCard}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Style="{StaticResource RowToggleStyle}"
